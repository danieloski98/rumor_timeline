APP_ENV=dev
PORT=3000
CORS_ORIGIN=*
LOG_FORMAT=dev

# --- ClickHouse ---
CLICKHOUSE_URL=https://your-clickhouse-host:8443
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DATABASE=default
CLICKHOUSE_INVITE_TIMELINE_TABLE=invite_timeline_events
CLICKHOUSE_EVENTS_TABLE=events

# --- SQS worker ---
AWS_REGION=eu-central-1
SQS_QUEUE_URL=https://sqs.eu-central-1.amazonaws.com/123456789012/your-queue
SQS_MAX_MESSAGES=10
SQS_WAIT_TIME_SECONDS=20
SQS_POLL_INTERVAL_MS=1000

